# tclsh -> Enter command line
# exit

#puts -> printing

puts "Hello World!";

# Semicolon not required when one single line of statement such as:

puts "Hello World!"
puts "Semicolon not required"

# Semicolon is required when writing two commands in a single line such as:

puts "Hello World!"; puts "Not Hello"

# set is used for variable declaration

# Example:

set str "This is a string!";
puts "$str";

set var_value 1.5;
puts "The value is $var_value";